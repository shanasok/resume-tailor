# Optional — only if you ever switch resume tailoring to the Anthropic API instead of the
# claude CLI subscription. The CLI path (default) ignores/strips this.
ANTHROPIC_API_KEY=your_api_key_here

# Used for the external ChatGPT review pass (src/external_critic.py).
CHATGPT_API_KEY=your_openai_api_key_here
# Optional: override the OpenAI model (default gpt-4o)
# CHATGPT_MODEL=gpt-4o

# PostgreSQL connection (see docker-compose.yml). The default matches the compose db
# service as seen from the host, so you normally don't need to set this. Inside the
# app container, compose overrides it (host `db` instead of localhost).
# DATABASE_URL=postgresql://resume:resume@localhost:5432/resume_handler

# Claude CLI auth for the DOCKERIZED app. On the host the CLI uses your keychain login,
# but inside the container it can't — generate a long-lived subscription token once with
# `claude setup-token` (on your Mac) and paste it here.
# CLAUDE_CODE_OAUTH_TOKEN=your_token_from_claude_setup-token

# Local LLM backend (OpenAI-compatible, e.g. Ollama on your network — src/tailoring.py).
# Defaults to the network host below; set to localhost when Ollama runs on this machine.
# LOCAL_LLM_URL=http://100.108.61.107:11434
# LOCAL_LLM_URL=http://localhost:11434
#
# Local models are discovered live from LOCAL_LLM_URL's /api/tags — pick them per stage in
# the web UI's "LLM selection" section (↻ Refresh local models), or pass --gen-llm local:<tag>
# to the CLI. There is no fixed model list to configure here.

# ── Embeddings backend (Match %, meaning net, backfill ordering) ──────────────
# Which service turns text into vectors. Two options:
#   openai (default) — OpenAI text-embedding-3-small via CHATGPT_API_KEY/OPENAI_API_KEY.
#                      ~$0.02 per 1,000 job descriptions. Used when this var is unset.
#   local            — your Ollama server (LOCAL_LLM_URL above, endpoint /api/embed).
#                      No API key needed — fully free.
# EMBEDDING_BACKEND=local

# The Ollama embedding model tag when EMBEDDING_BACKEND=local (default: nomic-embed-text).
# Pull it first on the Ollama host, e.g.:  ollama pull nomic-embed-text
# NOTE: ":latest" is implicit in Ollama — "nomic-embed-text" and "nomic-embed-text:latest"
# are the SAME model, so the default finds it either way. BUT the app stores this string
# verbatim with every vector and treats different spellings as different models — changing
# the spelling later forces a full re-embed. Pick one form and stick with it (simplest:
# leave this unset and use the default).
# Other good options: mxbai-embed-large (better quality), qwen3-embedding (best, 32k context).
# LOCAL_EMBEDDING_MODEL=nomic-embed-text

# SWITCHING BACKENDS: vectors from different models are incompatible. After changing
# either var: restart the app, then press "Score fits (AI)" once on the home page —
# it re-embeds all stored jobs from their saved descriptions (AI Fit verdicts survive).

# Developer Options — set to 1 to reveal the Tools → Developer Options page (off by default).
# That page currently offers "Reset Retrieve Jobs": deletes your scan-discovered jobs that
# have no résumé and no application, and clears the rejection memory, so the next scan is fresh.
DEVELOPER_OPTIONS=0
